# Braintrust — get your key at https://www.braintrust.dev/app/settings?tab=api-keys
BRAINTRUST_API_KEY=

# AWS Bedrock — credenciais para chamar o Bedrock diretamente via boto3
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
AWS_DEFAULT_REGION=us-east-1

# Model ID do Bedrock (formato: {prefix}.anthropic.{model}-{version})
# Exemplos:
#   us.anthropic.claude-3-5-haiku-20241022-v1:0    (cross-region inference)
#   anthropic.claude-3-5-haiku-20241022-v1:0        (single-region)
LLM_MODEL=us.anthropic.claude-3-5-haiku-20241022-v1:0

# Temporal
TEMPORAL_HOST=localhost:7233
TEMPORAL_TASK_QUEUE=observability-demo

# Braintrust project name (created automatically on first run)
BRAINTRUST_PROJECT=observability-demo
